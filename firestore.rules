rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public list of registered booths (code + name only) so the login
    // screen can show them before anyone signs in. Any signed-in booth
    // account may append to it (during registration).
    match /booths_index/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Each booth's product/stock/sales data. Only the matching booth
    // account (signed in with that booth's own password via Firebase
    // Auth) may read or write it.
    match /booths/{boothId} {
      allow read: if request.auth != null
                  && request.auth.token.email == boothId + '@booths.boothpos.local';
      allow create: if request.auth != null
                    && request.auth.token.email == boothId + '@booths.boothpos.local';
      allow update: if request.auth != null
                    && request.auth.token.email == boothId + '@booths.boothpos.local';
      // A booth may delete only its own document (used when a vendor
      // permanently removes a booth from inside the app).
      allow delete: if request.auth != null
                    && request.auth.token.email == boothId + '@booths.boothpos.local';

      // Read-only day-session archives created when a booth starts a new
      // market day. Same booth-account-only access as the live document.
      match /sessions/{sessionId} {
        allow read: if request.auth != null
                    && request.auth.token.email == boothId + '@booths.boothpos.local';
        allow create: if request.auth != null
                      && request.auth.token.email == boothId + '@booths.boothpos.local';
        allow update: if request.auth != null
                      && request.auth.token.email == boothId + '@booths.boothpos.local';
        allow delete: if request.auth != null
                      && request.auth.token.email == boothId + '@booths.boothpos.local';
      }
    }
  }
}
